# Variables publiques, intégrées au bundle navigateur pendant le build
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SITE_URL=http://localhost:3000

# Variables serveur
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
DATABASE_URL=postgresql://postgres.project-ref:password@host:5432/postgres?sslmode=require

# Création idempotente du premier administrateur au démarrage Docker
BOOTSTRAP_ADMIN_ID=administrateur
BOOTSTRAP_ADMIN_PASSWORD=
# Passer temporairement à true pour forcer le remplacement du mot de passe existant
BOOTSTRAP_ADMIN_FORCE_PASSWORD=false

# Liens éditoriaux optionnels
VITE_HEMLE_GOOGLE_FORM_URL=https://forms.gle/replace_me
VITE_HEMLE_WHATSAPP_URL=https://whatsapp.com/channel/replace_me
VITE_HEMLE_EMAIL=contact@example.com
VITE_HEMLE_MAGAZINE_URL=https://example.com
VITE_HEMLE_FACEBOOK_URL=https://facebook.com/example
VITE_HEMLE_INSTAGRAM_URL=https://instagram.com/example
VITE_HEMLE_LINKEDIN_URL=https://linkedin.com/company/example
